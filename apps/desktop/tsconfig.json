{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "noEmit": true,
    "paths": {
      "@kovach-dev/memory-contract": [
        "../../packages/memory-contract/src/index.ts"
      ],
      "@kovach-dev/memory-contract/mock": [
        "../../packages/memory-contract/src/mock.ts"
      ],
      "@kovach-dev/memory-service": [
        "../../packages/memory-service/src/index.ts"
      ],
      "@kovach-dev/agent": [
        "../../packages/agent/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "scripts",
    "*.ts"
  ]
}
