    {
      "id": "lv-research-middleware",
      "stack": "php",
      "note": "A fact learned from official docs.",
      "steps": [
        [
          "user",
          "Does Laravel 11 still have app/Http/Kernel.php for registering middleware?"
        ],
        [
          "tool",
          "fetch_page",
          {
            "url": "https://laravel.com/docs/11.x/middleware"
          },
          0,
          "Middleware - Laravel 11.x\nRegistering Middleware\nGlobal Middleware\nIf you want a middleware to run during every HTTP request to your application, you may append it to the global middleware stack in your application's bootstrap/app.php file: ->withMiddleware(function (Middleware $middleware) { $middleware->append(EnsureTokenIsValid::class); })"
        ],
        [
          "assistant",
          "No. In Laravel 11 middleware is registered in bootstrap/app.php with ->withMiddleware(); the HTTP kernel class is gone."
        ]
      ],
      "expect": [
        {
          "match": "bootstrap/app\\.php|withMiddleware|kernel",
          "kind": "research"
        }
      ],
      "project": "tax-api"
    },
